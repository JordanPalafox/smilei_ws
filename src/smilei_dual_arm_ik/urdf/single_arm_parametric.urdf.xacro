<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="smilei_single_arm">

  <!-- Load parameters from YAML file -->
  <!-- The actual values will be passed from the launch file as arguments -->

  <!-- Define constants -->
  <xacro:property name="PI" value="3.14159265359"/>
  <xacro:property name="PI_2" value="${PI/2}"/>
  <xacro:property name="PI_4" value="${PI/4}"/>

  <!-- Declare arguments with default values -->
  <!-- Neck dimensions -->
  <xacro:arg name="neck_height" default="0.34"/>
  <xacro:property name="neck_height" value="$(arg neck_height)"/>

  <!-- Arm dimensions -->
  <xacro:arg name="base_height" default="0.34"/>
  <xacro:property name="base_height" value="$(arg base_height)"/>

  <xacro:arg name="link0_length" default="0.10"/>
  <xacro:property name="link0_length" value="$(arg link0_length)"/>

  <xacro:arg name="link0_width" default="0.0"/>
  <xacro:property name="link0_width" value="$(arg link0_width)"/>

  <xacro:arg name="link1_length" default="0.15"/>
  <xacro:property name="link1_length" value="$(arg link1_length)"/>

  <xacro:arg name="link1_width" default="-0.30"/>
  <xacro:property name="link1_width" value="$(arg link1_width)"/>

  <xacro:arg name="link2_length" default="0.25"/>
  <xacro:property name="link2_length" value="$(arg link2_length)"/>

  <xacro:arg name="link2_width" default="0.20"/>
  <xacro:property name="link2_width" value="$(arg link2_width)"/>

  <xacro:arg name="link3_length" default="0.2"/>
  <xacro:property name="link3_length" value="$(arg link3_length)"/>

  <xacro:arg name="link4_length" default="-0.08"/>
  <xacro:property name="link4_length" value="$(arg link4_length)"/>

  <xacro:arg name="ee_offset" default="0.0"/>
  <xacro:property name="ee_offset" value="$(arg ee_offset)"/>

  <!-- Joint limits -->
  <xacro:arg name="joint0_lower" default="-3.14159265359"/>
  <xacro:property name="joint0_lower" value="$(arg joint0_lower)"/>

  <xacro:arg name="joint0_upper" default="3.14159265359"/>
  <xacro:property name="joint0_upper" value="$(arg joint0_upper)"/>

  <xacro:arg name="joint1_lower" default="-1.57079632679"/>
  <xacro:property name="joint1_lower" value="$(arg joint1_lower)"/>

  <xacro:arg name="joint1_upper" default="1.57079632679"/>
  <xacro:property name="joint1_upper" value="$(arg joint1_upper)"/>

  <xacro:arg name="joint2_lower" default="-2.0"/>
  <xacro:property name="joint2_lower" value="$(arg joint2_lower)"/>

  <xacro:arg name="joint2_upper" default="2.0"/>
  <xacro:property name="joint2_upper" value="$(arg joint2_upper)"/>

  <xacro:arg name="joint3_lower" default="-3.14159265359"/>
  <xacro:property name="joint3_lower" value="$(arg joint3_lower)"/>

  <xacro:arg name="joint3_upper" default="3.14159265359"/>
  <xacro:property name="joint3_upper" value="$(arg joint3_upper)"/>

  <!-- Joint dynamics -->
  <xacro:arg name="joint0_effort" default="100.0"/>
  <xacro:property name="joint0_effort" value="$(arg joint0_effort)"/>

  <xacro:arg name="joint0_velocity" default="1.0"/>
  <xacro:property name="joint0_velocity" value="$(arg joint0_velocity)"/>

  <xacro:arg name="joint1_effort" default="100.0"/>
  <xacro:property name="joint1_effort" value="$(arg joint1_effort)"/>

  <xacro:arg name="joint1_velocity" default="1.0"/>
  <xacro:property name="joint1_velocity" value="$(arg joint1_velocity)"/>

  <xacro:arg name="joint2_effort" default="80.0"/>
  <xacro:property name="joint2_effort" value="$(arg joint2_effort)"/>

  <xacro:arg name="joint2_velocity" default="1.0"/>
  <xacro:property name="joint2_velocity" value="$(arg joint2_velocity)"/>

  <xacro:arg name="joint3_effort" default="50.0"/>
  <xacro:property name="joint3_effort" value="$(arg joint3_effort)"/>

  <xacro:arg name="joint3_velocity" default="2.0"/>
  <xacro:property name="joint3_velocity" value="$(arg joint3_velocity)"/>


  <!-- Base Link -->
  <link name="base_link" />

  <!-- Neck Base Joint - Fixed -->
  <joint name="neck_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="neck_base"/>
    <origin xyz="0 0 ${neck_height}" rpy="0 0 0"/>
  </joint>

  <!-- Base Link (Neck Base) - Fixed reference frame -->
  <link name="neck_base">
    <visual>
      <geometry>
        <box size="0.1 0.1 ${base_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 1 - Shoulder Pan (rotation around Z axis) -->
  <joint name="joint_0" type="revolute">
    <parent link="neck_base"/>
    <child link="link_1"/>
    <origin xyz="${link0_length} 0 0" rpy="${PI_2} 0 ${PI_2}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${joint0_lower}" upper="${joint0_upper}" effort="${joint0_effort}" velocity="${joint0_velocity}"/>
  </joint>

  <link name="link_1">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="${link1_length}"/>
      </geometry>
      <origin xyz="${link1_width/2} 0 ${link1_length/2}" rpy="0 0 0"/>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="${link1_width/2} 0 ${link1_length/2}" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- Joint 1 - Shoulder Lift (rotation around Y axis) -->
  <joint name="joint_1" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="${link1_width} 0 ${link1_length}" rpy="${PI_2} 0 ${PI_2}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${joint1_lower}" upper="${joint1_upper}" effort="${joint1_effort}" velocity="${joint1_velocity}"/>
  </joint>

  <link name="link_2">
    <visual>
      <geometry>
        <box size="${link2_length} 0.05 0.05"/>
      </geometry>
      <origin xyz="${link2_length/2} 0 0" rpy="0 0 0"/>
      <material name="red">
        <color rgba="0.8 0.0 0.0 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="${link2_length/2} 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <!-- Joint 2 - Elbow (rotation around Y axis) -->
  <joint name="joint_2" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 ${link2_length} ${link2_width}" rpy="${-PI_2} ${-PI_2} 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${joint2_lower}" upper="${joint2_upper}" effort="${joint2_effort}" velocity="${joint2_velocity}"/>
  </joint>

  <link name="link_3">
    <visual>
      <geometry>
        <box size="${link3_length} 0.04 0.04"/>
      </geometry>
      <origin xyz="${link3_length/2} 0 0" rpy="0 0 0"/>
      <material name="green">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="${link3_length/2} 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 4 - Wrist Rotation (rotation around X axis) -->
  <joint name="joint_3" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 ${link3_length}" rpy="${PI_2} 0 ${PI_2}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${joint3_lower}" upper="${joint3_upper}" effort="${joint3_effort}" velocity="${joint3_velocity}"/>
  </joint>

  <link name="link_4">
    <visual>
      <geometry>
        <cylinder radius="0.025" length="${link4_length}"/>
      </geometry>
      <origin xyz="${link4_length/2} 0 0" rpy="0 ${PI_2} 0"/>
      <material name="yellow">
        <color rgba="0.8 0.8 0.0 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="${link4_length/2} 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0003" ixy="0.0" ixz="0.0" iyy="0.0003" iyz="0.0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- End Effector Joint - Fixed -->
  <joint name="end_effector_joint" type="fixed">
    <parent link="link_4"/>
    <child link="end_effector"/>
    <origin xyz="0 ${link4_length + ee_offset} 0" rpy="${PI_2} 0 ${PI_2}"/>
  </joint>

  <link name="end_effector">
    <visual>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="purple">
        <color rgba="0.5 0.0 0.5 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

</robot>
